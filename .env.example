# PostgreSQL database connection string (e.g. Neon.tech, Supabase, or local PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/talentmatch?sslmode=require"

# OpenAI API key used by the matching agent
OPENAI_API_KEY="sk-your-openai-api-key"

# Local directory path containing the corpus/ and queries/ folders (excluded from Git)
DATA_DIR="./local_data"